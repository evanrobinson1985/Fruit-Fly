<?xml version="1.0" encoding="utf-8"?>
<!-- The app serves its bundled website over HTTP on the loopback interface only. -->
<network-security-config>
    <!-- IP-literal loopback hosts are not consistently matched by domain-config on all
         Android/WebView versions. Permit cleartext for this app's local embedded server. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
